38352>>>        WebSet pbRender of oEditBtn to False
38353>>>        WebSet pbRender of oSaveBtn to False
38354>>>        WebSet pbRender of oCancelChangesBtn to False
38355>>>        WebSet pbRender of oDeleteBtn to False
38356>>>
38356>>>        If (NavigateData.bReadOnly) Begin
38358>>>            WebSet pbRender of oEditBtn to True
38359>>>        End
38359>>>>
38359>>>        Else Begin
38360>>>            WebSet pbRender of oSaveBtn to True
38361>>>            WebSet pbRender of oCancelChangesBtn to True
38362>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38363>>>        End
38363>>>>
38363>>>    End_Procedure
